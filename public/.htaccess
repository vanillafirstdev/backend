# public/.htaccess — every request goes to the front controller.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache drops the Authorization header before PHP sees it unless told to
    # pass it on. Without this line the API key check always fails on Apache.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "(^\.|\.(sqlite|sqlite3|db|sql|log|bak|ini|env|md|lock)$)">
    Require all denied
</FilesMatch>
